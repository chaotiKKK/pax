{
  "name": "pax-aeterna",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Pax Aeterna — a 4X space strategy reimagining with LAN multiplayer, Windows and Android shells",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "python tools/blender/run_assets.py",
    "lan": "node server/relay.mjs",
    "win": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --dir",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@types/three": "^0.180.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.paxaeterna.game",
    "productName": "Pax Aeterna",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
